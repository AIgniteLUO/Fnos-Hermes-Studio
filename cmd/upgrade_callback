#!/bin/bash

### 升级后回调 — 校验/重装 hermes-web-ui（npm 模式），修复权限
### 与 install_callback 保持幂等：版本一致则跳过，不一致则覆盖安装

# 注意：不 set -e。避免因权限/用户差异导致非关键命令返回非零而使飞牛报"设置目录权限失败"。

# 动态解析路径
_resolve_paths() {
    local app_link="/var/apps/hermes-studio"
    if [ -z "${TRIM_APPDEST}" ] && [ -e "${app_link}" ]; then
        TRIM_APPDEST="$(readlink -f "${app_link}" 2>/dev/null)"
    fi
    if [ -z "${TRIM_PKGHOME}" ] && [ -L "${app_link}/home" ]; then
        TRIM_PKGHOME="$(readlink -f "${app_link}/home" 2>/dev/null)"
    fi
    if [ -z "${TRIM_PKGVAR}" ] && [ -L "${app_link}/var" ]; then
        TRIM_PKGVAR="$(readlink -f "${app_link}/var" 2>/dev/null)"
    fi
    if [ -n "${TRIM_APPDEST}" ]; then
        [ -z "${TRIM_PKGHOME}" ] && TRIM_PKGHOME="$(echo "${TRIM_APPDEST}" | sed 's|/@appcenter/|/@apphome/|')"
        [ -z "${TRIM_PKGVAR}" ] && TRIM_PKGVAR="$(echo "${TRIM_APPDEST}" | sed 's|/@appcenter/|/@appdata/|')"
    fi
}
_resolve_paths

LOG_FILE="${TRIM_PKGVAR:-/tmp/hermes-studio-var}/info.log"
mkdir -p "$(dirname "${LOG_FILE}")" 2>/dev/null || true

log_msg() {
    local msg="$(date '+%Y-%m-%d %H:%M:%S') - [upgrade] $1"
    echo "$msg"
    echo "$msg" >> "${LOG_FILE}" 2>/dev/null || true
}

toast_err() {
    echo "$*" > "${TRIM_TEMP_LOGFILE:-/tmp/hermes-studio-install.err}"
}

# 使用 fnOS 应用中心 Node.js 运行时
resolve_node_root() {
    local cand
    for cand in /var/apps/nodejs_v24/target \
                /var/apps/nodejs_v22/target \
                /var/apps/nodejs_v23/target \
                /vol1/@appcenter/nodejs_v24 \
                /vol2/@appcenter/nodejs_v24 \
                /vol3/@appcenter/nodejs_v24 \
                /vol4/@appcenter/nodejs_v24 \
                /vol1/@appcenter/nodejs_v22 \
                /vol2/@appcenter/nodejs_v22 \
                /vol3/@appcenter/nodejs_v22 \
                /vol4/@appcenter/nodejs_v22 \
                /vol1/@appcenter/nodejs_v23 \
                /vol2/@appcenter/nodejs_v23 \
                /vol3/@appcenter/nodejs_v23 \
                /vol4/@appcenter/nodejs_v23; do
        [ -x "${cand}/bin/node" ] && { echo "${cand}"; return 0; }
    done
    return 1
}

DATA_DIR="${TRIM_PKGHOME}/data"
NODE_ROOT="$(resolve_node_root)"
NODE_BIN="${NODE_ROOT}/bin/node"
HERMES_AGENT_ROOT="${TRIM_PKGHOME}/hermes-agent"
HERMES_HOME="${TRIM_PKGHOME}/hermes-home"
APP_DIR="${TRIM_APPDEST}"
HERMES_BIN="${DATA_DIR}/node/lib/node_modules/hermes-web-ui/bin/hermes-web-ui.mjs"

export HOME="${DATA_DIR}"
export HERMES_WEB_UI_HOME="${DATA_DIR}"
export PATH="${NODE_ROOT}/bin:${DATA_DIR}/node/bin:${PATH}"
export npm_config_registry="https://registry.npmmirror.com"

# ---------------------------------------------------------------------------
# 1. 升级时直接调用已验证的 install_callback 完成完整平滑安装
# ---------------------------------------------------------------------------
run_install_callback() {
    local cb
    cb="$(cd "$(dirname "$0")" && pwd)/install_callback"
    if [ -x "${cb}" ]; then
        log_msg "Invoking install_callback for upgrade: ${cb}"
        exec "${cb}"
    fi
    cb="${APP_DIR}/cmd/install_callback"
    if [ -x "${cb}" ]; then
        log_msg "Invoking install_callback for upgrade: ${cb}"
        exec "${cb}"
    fi
    cb="/var/apps/hermes-studio/cmd/install_callback"
    if [ -x "${cb}" ]; then
        log_msg "Invoking install_callback for upgrade: ${cb}"
        exec "${cb}"
    fi
    toast_err "找不到 install_callback"
    exit 1
}

run_install_callback
