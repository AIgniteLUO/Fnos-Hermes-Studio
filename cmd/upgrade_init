#!/bin/bash

### 升级前回调 — 停止应用并清理所有残留进程与句柄，避免解压覆盖与权限设置冲突

# 动态推导路径，避免 hardcode /vol1 导致在 /vol2 /vol3 上找不到卷
_resolve_paths() {
    local app_link="/var/apps/hermes-studio"
    if [ -z "${TRIM_APPDEST}" ] && [ -e "${app_link}" ]; then
        TRIM_APPDEST="$(readlink -f "${app_link}" 2>/dev/null)"
    fi
    if [ -z "${TRIM_PKGHOME}" ] && [ -L "${app_link}/home" ]; then
        TRIM_PKGHOME="$(readlink -f "${app_link}/home" 2>/dev/null)"
    fi
    if [ -z "${TRIM_PKGVAR}" ] && [ -L "${app_link}/var" ]; then
        TRIM_PKGVAR="$(readlink -f "${app_link}/var" 2>/dev/null)"
    fi
    if [ -n "${TRIM_APPDEST}" ]; then
        [ -z "${TRIM_PKGHOME}" ] && TRIM_PKGHOME="$(echo "${TRIM_APPDEST}" | sed 's|/@appcenter/|/@apphome/|')"
        [ -z "${TRIM_PKGVAR}" ] && TRIM_PKGVAR="$(echo "${TRIM_APPDEST}" | sed 's|/@appcenter/|/@appdata/|')"
    fi
}
_resolve_paths

LOG_FILE="${TRIM_PKGVAR:-/tmp/hermes-studio-var}/info.log"
mkdir -p "$(dirname "${LOG_FILE}")" 2>/dev/null || true

log_msg() {
    local msg="$(date '+%Y-%m-%d %H:%M:%S') - [upgrade_init] $1"
    echo "$msg" >> "${LOG_FILE}" 2>/dev/null || true
}

log_msg "=== upgrade_init start ==="
log_msg "TRIM_APPDEST=${TRIM_APPDEST} TRIM_PKGHOME=${TRIM_PKGHOME} TRIM_PKGVAR=${TRIM_PKGVAR}"

# 1. 强制终止所有相关运行与后台安装进程（避免文件句柄占用导致覆盖/权限失败）
pkill -9 -f "bin/hermes-web-ui" 2>/dev/null || true
pkill -9 -f "dist/server/index.js" 2>/dev/null || true
pkill -9 -f "hermes-agent" 2>/dev/null || true
pkill -9 -f "install-agent" 2>/dev/null || true
pkill -9 -f "hermes gateway" 2>/dev/null || true
pkill -9 -f "hermes_bridge" 2>/dev/null || true
pkill -9 -f "hermes-studio-mcp" 2>/dev/null || true
pkill -9 -f "mcp_stdio_watchdog" 2>/dev/null || true
pkill -9 -f "playwright" 2>/dev/null || true

# 2. 等待进程完全释放（最多 8 秒）
_wait=0
while [ ${_wait} -lt 8 ]; do
    if ! pgrep -f "bin/hermes-web-ui" >/dev/null 2>&1 \
       && ! pgrep -f "dist/server/index.js" >/dev/null 2>&1 \
       && ! pgrep -f "install-agent" >/dev/null 2>&1; then
        break
    fi
    sleep 1
    _wait=$((_wait + 1))
done
log_msg "进程清理完成 (等待 ${_wait}s)"

# 3. 清理残留 PID 文件与 IPC socket
rm -f "${TRIM_PKGHOME}/data/server.pid" 2>/dev/null || true
rm -f "${TRIM_PKGHOME}/hermes-home/.install-agent.pid" 2>/dev/null || true
rm -f /tmp/hermes-agent-bridge.sock 2>/dev/null || true
rm -f /tmp/hermes-web-ui.sock 2>/dev/null || true

sleep 1
log_msg "=== upgrade_init end ==="
exit 0
