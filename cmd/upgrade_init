#!/bin/bash

### 升级前回调 — 停止应用并清理残留进程，避免解压新文件时冲突

TRIM_APPDEST="${TRIM_APPDEST:-/vol1/@appcenter/hermes-studio}"
TRIM_PKGHOME="${TRIM_PKGHOME:-/vol1/@apphome/hermes-studio}"
TRIM_PKGVAR="${TRIM_PKGVAR:-/vol1/@appdata/hermes-studio}"
LOG_FILE="${TRIM_PKGVAR}/info.log"

log_msg() {
    local msg="$(date '+%Y-%m-%d %H:%M:%S') - [upgrade_init] $1"
    echo "$msg" >> "${LOG_FILE}" 2>/dev/null || true
}

log_msg "=== upgrade_init start ==="

# 强制 kill 残留进程
pkill -9 -f "bin/hermes-web-ui" 2>/dev/null || true
pkill -9 -f "dist/server/index.js" 2>/dev/null || true

# 等待进程完全退出（最多 10 秒）
_wait=0
while [ ${_wait} -lt 10 ]; do
    if ! pgrep -f "bin/hermes-web-ui" >/dev/null 2>&1 \
       && ! pgrep -f "dist/server/index.js" >/dev/null 2>&1; then
        break
    fi
    sleep 1
    _wait=$((_wait + 1))
done
log_msg "进程清理完成 (等待 ${_wait}s)"

# 删除残留 PID 文件
rm -f "${TRIM_PKGHOME}/data/server.pid" 2>/dev/null || true

# 额外等待 2 秒，确保文件系统释放所有句柄
sleep 2

log_msg "=== upgrade_init end ==="
exit 0
